{
  "LambdaFunctionConfigurations": [
    {
      "Id": "resize-on-upload",
      "LambdaFunctionArn": "arn:aws:lambda:us-east-1:946869378835:function:resize-lambda-fn",
      "Events": ["s3:ObjectCreated:*"],
      "Filter": { "Key": { "FilterRules": [ { "Name": "prefix", "Value": "resize/" } ] } }
    },
    {
      "Id": "greyscale-on-upload",
      "LambdaFunctionArn": "arn:aws:lambda:us-east-1:946869378835:function:greyscale-lambda-fn",
      "Events": ["s3:ObjectCreated:*"],
      "Filter": { "Key": { "FilterRules": [ { "Name": "prefix", "Value": "greyscale/" } ] } }
    },
    {
      "Id": "exif-on-upload",
      "LambdaFunctionArn": "arn:aws:lambda:us-east-1:946869378835:function:exif-lambda-fn",
      "Events": ["s3:ObjectCreated:*"],
      "Filter": { "Key": { "FilterRules": [ { "Name": "prefix", "Value": "exif/" } ] } }
    }
  ]
}
